{
  "name": "abhay-jaiswal-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-blog-pages.mjs",
    "preview": "vite preview",
    "start": "vite",
    "blog:new": "node scripts/new-blog-post.mjs",
    "blog:check": "node -e \"import('./src/data/blogArticles.js').then(({articles}) => console.log(articles.length + ' valid blog articles'))\"",
    "lint": "eslint .",
    "check:unused": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/check-visual.mjs",
    "check": "npm run lint && npm run test && npm run check:unused && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
